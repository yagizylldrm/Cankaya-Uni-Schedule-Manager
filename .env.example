# Çankaya Üniversitesi Ders Programı & Randevu Yöneticisi Ortam Değişkenleri

# 1. OGBS API Token (Veri toplama/güncelleme scriptleri için gereklidir)
# Örnek: OGBS_API_TOKEN=1|your_bearer_token_here
OGBS_API_TOKEN=

# 2. Spor Randevu Servisi Bağlantı URL'i (Vercel / Production ortamında zorunlu)
# Kullanıcının kontrolündeki sabit ngrok HTTPS reverse proxy adresi
# Örnek: SPORTS_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
SPORTS_BASE_URL=

# 3. Spor Randevu Oturum Şifreleme Anahtarı (Production ortamında zorunlu)
# Oturum çerezlerini istemcide güvenli şekilde tutmak için kullanılan yüksek entropili anahtar
# Örnek: openssl rand -hex 32 ile üretilebilir
SPORTS_SESSION_SECRET=

# 4. Geliştirme / Test Ortamı Ayarları
ENVIRONMENT=development
